{
  "name": "multx-adapter",
  "version": "0.1.0-pre",
  "description": "Shared MultX bridge adapter for Ignite.trade, MagmaDEX.trade, Quantts.ai and KaJ Labs products. Manifest-driven, disabled by default until an approved release identity is configured.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsc -p tsconfig.json --noEmit && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo 'no lint configured'"
  },
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "ethers": "^6.13.4",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "keywords": [
    "multx",
    "bridge",
    "lithosphere",
    "kaj-labs",
    "ignite",
    "magmadex",
    "quantts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imasssad/Thanos-Wallet.git",
    "directory": "packages/multx-adapter"
  }
}
