# =============================================================================
# THANOS WALLET — ENVIRONMENT VARIABLES
# Copy this to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_DB=thanos_wallet
POSTGRES_USER=thanos
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DATABASE_URL=postgresql://thanos:CHANGE_THIS_STRONG_PASSWORD@localhost:5432/thanos_wallet
# Optional tuning — both have sane defaults, only set if you need to override.
#PG_POOL_MAX=10        # services/worker's pg Pool max connections (default 10)
#DATABASE_SSL=true     # services/indexer only — set true for a managed/remote
                        # Postgres that requires TLS (rejectUnauthorized: false)

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD@localhost:6379

# ─── Auth / JWT ────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# ─── Lithosphere / Makalu RPC ──────────────────────────────────────────────
# Makalu = testnet (chain 700777). Kamet = sister testnet chain for DNNS
# (chain 900523). Lithosphere Mainnet (chain 9005, live 2026-08) is the
# actual production chain — see packages/sdk-core/src/chains/networks.ts.
# Failover: every RPC consumer builds an ethers FallbackProvider over the
# primary + fallback — if the primary stalls (>1.5s) traffic rotates to the
# fallback transparently. The indexer prefers rpc-2 as its primary so its
# sync load doesn't compete with user traffic on rpc.litho.ai.
LITHO_RPC_PRIMARY=https://rpc.litho.ai
LITHO_RPC_FALLBACK=https://rpc-2.litho.ai
LITHO_RPC_INDEXER=https://rpc-2.litho.ai
LITHO_CHAIN_ID=700777  # informational only — not read by any code, Makalu's id is hardcoded where needed
# Kamet: rpc-3.litho.ai is the ONLY canonical RPC. The old 2-level host
# rpc.kamet.litho.ai is TLS-broken behind Cloudflare and deprecated by
# Litho ops — do not re-add it as a fallback.
KAMET_RPC_PRIMARY=https://rpc-3.litho.ai
KAMET_RPC_FALLBACK=https://rpc-3.litho.ai
KAMET_REST_URL=https://api-3.litho.ai
KAMET_CHAIN_ID=900523
# Web bundle reads the comma-separated Makalu list (primary,fallback).
NEXT_PUBLIC_LITHO_RPC=https://rpc.litho.ai,https://rpc-2.litho.ai

# ─── Other Chain RPCs ──────────────────────────────────────────────────────
# ETH_RPC_URL is NOT read anywhere in this repo (backend or clients) —
# removed 2026-09-18 audit rather than left as dead/misleading config. The
# actual var names, confirmed against the code that reads them:
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com          # services/api, services/worker
BITCOIN_MEMPOOL_URL=https://mempool.space/api                # services/api (portfolio.ts)
BITCOIN_MEMPOOL_API=https://mempool.space/api                # services/worker (chain-rpc.ts) — same
                                                               # service, deliberately kept as two
                                                               # separate vars rather than unifying
                                                               # the name, to avoid a silent runtime
                                                               # behavior change from an audit pass.
COSMOS_REST_URL=https://cosmos-rest.publicnode.com            # services/api (portfolio.ts)

# BSC (chain 56). Default is the public BNB Chain dataseed (no key).
# To use a keyed provider (Alchemy / QuickNode / Chainstack / dRPC / …),
# set BNB_RPC_PRIMARY to its URL — the worker then builds a FallbackProvider
# of [keyed, public dataseed]. BNB_RPC_FALLBACK overrides the fallback host.
# Consumed by services/worker/src/lib/chain-rpc.ts. The user-facing clients
# read their own build-time public var for this instead — not wired yet,
# add per surface once a keyed URL exists (NEXT_PUBLIC_BNB_RPC for web,
# EXPO_PUBLIC_BNB_RPC for mobile, VITE_BNB_RPC for desktop/extension).
BNB_RPC_PRIMARY=
BNB_RPC_FALLBACK=https://bsc-dataseed.bnbchain.org

# ─── LEP100 (standard ERC-20 + burn/burnFrom/owner) ────────────────────────
# Full ABI in repo: contracts/artifacts/contracts/LEP100Token.sol/LEP100Token.json
# Verified addresses: https://makalu.litho.ai
#
# Native (gas) coin — no token address:
#   LITHO https://makalu.litho.ai/token/native
#
# Lithosphere ecosystem LEP100 tokens (Makalu, chain 700777).
#
# IMPORTANT: these env vars OVERRIDE the verified built-in defaults in
# services/indexer/src/chain.ts — a wrong value here silently re-points
# the indexer at a dead contract. Every address below was verified live
# on-chain by the Litho infra team on 2026-06-10 and matches
# packages/sdk-core/src/tokens/makalu-lep100-source.ts exactly. In most
# deploys you can simply DELETE this whole block and let the code
# defaults win.
#
# Naming (per on-chain name()/symbol(), verified 2026-06-12): FGPT's
# name() is "FurGPT" and MUSA's is "Mansa AI". Never add a
# MAKALU_LEP100_FURGPT_ADDRESS var — that key historically pointed at
# the WRONG contract (MUSA's) and the indexer ignores it outright; the
# FurGPT token's var is MAKALU_LEP100_FGPT_ADDRESS.
MAKALU_LEP100_WLITHO_ADDRESS=0x599a7E135f1790ae117b4EdDc0422D24Bc766161
MAKALU_LEP100_LITBTC_ADDRESS=0xC4645CA5411D6E27556780AB4cdd0DF7e609df74
MAKALU_LEP100_LAX_ADDRESS=0x1Cde2Ca6c2ab8622003ebe06e382bC07850d4B8d
MAKALU_LEP100_JOT_ADDRESS=0xEF2f35f6d0fb7DC9E87b8ca8252AE2E6ffb2a25e
MAKALU_LEP100_COLLE_ADDRESS=0x10D4BB600c96e9243E2f50baFED8b2478F25af61
MAKALU_LEP100_IMAGE_ADDRESS=0xAcD98E323968647936887aD4934e64B01060727e
MAKALU_LEP100_AGII_ADDRESS=0x10052B8ccD2160b8F9880C6b4F5DD117fF253B1c
MAKALU_LEP100_BLDR_ADDRESS=0x798eD6bFc5bfCFc60938d5098825b354427A0786
MAKALU_LEP100_FGPT_ADDRESS=0x151ef362eA96853702Cc5e7728107e3961fbD22e
MAKALU_LEP100_MUSA_ADDRESS=0xDB829befCF8E582379E2c034FA2589b8D2EA1c5D

# ─── DNNS (decentralised name service, lives on Kamet chain 900523) ────────
# Schema-compatible with ENS. NameWrapper is the canonical entry point.
DNNS_NAME_WRAPPER_ADDRESS=0xc47E49259b8dDa2C9D57941E1a52747E4c721Cb9
DNNS_REGISTRY_ADDRESS=0x316dc15bF377F7187e5BE38BA19e673Ca823d1ab
DNNS_BASE_REGISTRAR_ADDRESS=0xB3D1a8e92FFAD73Ab8a07BF37A8E1374df8B3722
DNNS_METADATA_SERVICE_ADDRESS=0x9138E4CD9c5EBAc6964Fd28516BD5B0E83E5AA51
DNNS_METADATA_URI=https://names.litho.ai/metadata/{id}
# Resolver cache TTLs — optional, sane defaults (services/api/src/routes/dnns.ts).
#DNNS_POSITIVE_TTL_SEC=300  # how long a resolved name is cached (default 5 min)
#DNNS_NEGATIVE_TTL_SEC=30   # how long a NOT-FOUND result is cached (default 30s)

# ─── MultX (Swap / Bridge — internal Litho service, no auth layer) ─────────
# No API key — the bridge is keyless. URL is fixed; only override for a
# staging bridge. NEXT_PUBLIC_MULTX_API_URL exposes it to the web bundle.
MULTX_API_URL=https://bridge.litho.ai
NEXT_PUBLIC_MULTX_API_URL=https://bridge.litho.ai

# ─── Ignite DEX (same-chain swaps, internal Litho service, no auth) ────────
# Live by default — the wallet-engine builds a LiveIgniteClient pointing at
# this URL. If the response shape doesn't match the provisional spec the
# SwapModal catches IgniteUnavailable and falls back to MultX, so a
# half-matched endpoint degrades rather than breaking the wallet.
#
# Override the base URL only for a staging endpoint.
IGNITE_API_URL=https://ignite.litho.ai
NEXT_PUBLIC_IGNITE_API_URL=https://ignite.litho.ai
#
# Force the deterministic mock client (used in CI + offline dev). Leave
# UNSET in production. Any non-empty value other than 'mock' is ignored.
# THANOS_IGNITE=mock

# ─── LAX card (Zypto white-label, "FCFpay" underneath — see
#     services/api/src/routes/lax.ts + docs/integrations/LAX-INTEGRATION-REQUEST.md)
# Self-service via https://dashboard.lax.money/ (Project "LAX Card", id 612):
#   LAX_API_KEY     — Project List -> "Get api key" / "Refresh Key"
#   LAX_API_BASE    — dashboard root, e.g. https://dashboard.lax.money
#   LAX_PROJECT_ID  — 612 (LAX Card). No Virtual Cards section on this
#                     project — live ops use /api/physical-cards/*; native
#                     instant issue stays off until physical KYC is wired.
#   LAX_WEBHOOK_SECRET — shared secret for POST /lax-webhook
# Active currencies: GET /api/general/available_currencies (docs/cards) —
# re-checked at least every 24h (server + client cache).
# NO SANDBOX — every configured call hits real production (confirmed by Zypto).
LAX_API_KEY=
LAX_API_BASE=
LAX_PROJECT_ID=612
# Required for native virtual-card issuance. Obtain both values from the
# LAX/Zypto dashboard; do not guess them or expose them to client apps.
LAX_IFRAME_ID=
LAX_PRODUCT_ID=
LAX_WEBHOOK_SECRET=

# ─── WalletConnect / ReOwn ─────────────────────────────────────────────────
# Get project ID from: https://cloud.reown.com  (formerly cloud.walletconnect.com)
WALLETCONNECT_PROJECT_ID=6d05d9a84112ca2f7c1bb77a76a18c81
REOWN_PROJECT_ID=6d05d9a84112ca2f7c1bb77a76a18c81
# Exposed to the browser bundle for the WalletConnect modal:
NEXT_PUBLIC_REOWN_PROJECT_ID=6d05d9a84112ca2f7c1bb77a76a18c81

# ─── Pricing ───────────────────────────────────────────────────────────────
PRICE_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# ─── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=

# Alertmanager (ops/observability/docker-compose.observability.yml).
# Leave blank to disable that channel — the receiver silently no-ops.
# - Slack: create an incoming webhook at api.slack.com/apps → Incoming Webhooks.
# - PagerDuty: create an Events v2 integration on a service; use its "Integration Key".
SLACK_WEBHOOK_URL=
PAGERDUTY_INTEGRATION_KEY=

# ─── Mobile "update available" banner (GET /app-version) ──────────────────
# Bump these by hand after every mobile store release — nothing queries the
# App Store / Play Store automatically. Left unset, the banner never shows
# (no false positives).
LATEST_IOS_VERSION=
LATEST_ANDROID_VERSION=

# ─── App Ports ─────────────────────────────────────────────────────────────
# Not actually read from here — both services read the generic PORT env var
# (services/api/src/server.ts, services/indexer/src/server.ts), and
# docker-compose.yml sets it directly per-container (PORT: 4000 for api,
# PORT: 4010 for indexer) rather than sourcing it from .env. To change a
# port, edit docker-compose.yml, not this file. Listed here only as a
# reference for what each service listens on by default.
API_PORT=4000      # services/api    (docker-compose: PORT=4000)
INDEXER_PORT=4010  # services/indexer (docker-compose: PORT=4010)

# ─── Indexer hardening (optional) ──────────────────────────────────────────
# When set, POST /lep100/sync requires `Authorization: Bearer <token>` —
# a backfill rescans the whole chain, so internet-reachable deployments
# should set this. Leave unset for localhost/dev. The VPS ops commands
# call the endpoint via loopback, so add `-H "Authorization: Bearer $TOKEN"`
# to those curls after setting it.
#INDEXER_SYNC_TOKEN=
# Comma-separated origins allowed to hit the indexer directly (browsers
# normally reach it via the same-origin /indexer proxy, so this only
# matters for dev setups).
#CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Base URL services/api and services/worker use to reach services/indexer.
# docker-compose.yml points this at the indexer container (e.g.
# http://indexer:4010); default below is for running both locally.
#INDEXER_URL=http://localhost:4010
# Sync tuning — sane defaults, only set to change indexer sync behavior.
#INDEXER_MAX_BLOCKS_PER_BATCH=2000  # blocks per LEP100 sync pass
#INDEXER_INTERVAL_MS=15000          # ms between background sync passes

# ─── Internal push relay (services/api -> services/indexer's push.ts) ─────
# Shared secret for POST /push/notify (indexer -> api, internal only).
# Disabled (503, "never an open push relay") unless set — leave unset in
# dev; internet-reachable deployments should set a real value so agent/
# alert push notifications actually deliver.
#PUSH_INTERNAL_SECRET=

# ─── Metrics (services/worker) ─────────────────────────────────────────────
#METRICS_PORT=4020  # set to 0 to disable the metrics HTTP server entirely
