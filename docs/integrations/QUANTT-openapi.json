0,"default":3.5},"autopilot":{"type":"boolean","default":true},"timeframe":{"type":"string","enum":["5m","15m","1h","4h","1d"],"default":"1h"},"quoteAsset":{"type":"string","enum":["USDC","USDT","LAX"],"default":"USDC"}},"required":["name","strategy","chains","tokens","capitalUsd"],"additionalProperties":false}}}},"security":[{"bearerAuth":[]}],"responses":{"201":{"description":"Default Response","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"userId":{"type":"string"},"name":{"type":"string"},"strategy":{"type":"string"},"strategyPrompt":{"type":"string","nullable":true},"chains":{"type":"array","items":{"type":"string"}},"tokens":{"type":"array","items":{"type":"string"}},"dexPreference":{"type":"string"},"walletAddress":{"type":"string","nullable":true},"walletDerivationIndex":{"type":"number","nullable":true},"custodyModel":{"type":"string"},"capitalUsd":{"type":"number"},"maxPositionPct":{"type":"number"},"stopLoss":{"type":"number"},"takeProfit":{"type":"number"},"maxDailyLoss":{"type":"number"},"status":{"type":"string"},"autopilot":{"type":"boolean"},"timeframe":{"type":"string"},"quoteAsset":{"type":"string"},"createdAt":{"anyOf":[{"type":"string"},{"type":"string","format":"date-time"}]},"updatedAt":{"anyOf":[{"type":"string"},{"type":"string","format":"date-time"}]}},"required":["id","userId","name","strategy","chains","tokens","dexPreference","walletAddress","walletDerivationIndex","custodyModel","capitalUsd","maxPositionPct","stopLoss","takeProfit","maxDailyLoss","status","autopilot","timeframe","quoteAsset","createdAt","updatedAt"],"additionalProperties":true}}}}}}},"/v1/agents/{id}/deposit":{"post":{"summary":"Execute the real on-chain deposit (leg B) for a Magma agent.","tags":["agents"],"description":"Assumes the user already sent USDC on-chain to the agent's wallet. Approves + deposits into MagmaVault, then credits Magma's off-chain ledger — verified against the real on-chain event, not trusted.","para