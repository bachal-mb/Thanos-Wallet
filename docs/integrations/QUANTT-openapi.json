{"openapi":"3.0.3","info":{"title":"QUANTTS API","description":"AI-powered autonomous trading platform — public API surface.","version":"0.4.0","contact":{"name":"QUANTTS Support","email":"support@quantts.ai"}},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT","description":"User session JWT (for browser / mobile clients)."},"partnerKey":{"type":"apiKey","in":"header","name":"X-Partner-Key","description":"Partner API key scoped for machine-to-machine access."}},"schemas":{}},"paths":{"/health":{"get":{"summary":"Liveness and dependency status.","tags":["health"],"description":"Pings Redis, runs SELECT 1 against Postgres, and calls the decision engine's readiness probe. Returns 200 even when degraded — read the body, not the status code.","responses":{"200":{"description":"Default Response"}}}},"/v1/auth/check-email":{"post":{"summary":"Check whether an email is registered + verified.","tags":["auth"],"description":"Rate-limited to prevent enumeration abuse.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string","format":"email"}},"required":["email"],"additionalProperties":false}}}},"responses":{"200":{"description":"Default Response","content":{"application/json":{"schema":{"type":"object","properties":{"exists":{"type":"boolean"},"verified":{"type":"boolean"}},"required":["exists","verified"],"additionalProperties":false}}}}}}},"/v1/auth/register":{"post":{"summary":"Register a new user account.","tags":["auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","minLength":2},"email":{"type":"string","format":"email"},"password":{"type":"string","minLength":10}},"required":["name","email","password"],"additionalProperties":false}}}},"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/login":{"post":{"summary":"Log in with email + password.","tags":["auth"],"description":"Sets HttpOnly cookies for the browser client. Returns `{ mfaRequired: true }` when TOTP is enabled.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string","format":"email"},"password":{"type":"string","minLength":8}},"required":["email","password"],"additionalProperties":false}}}},"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/refresh":{"post":{"summary":"Refresh the access token using a valid refresh token.","tags":["auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"anyOf":[{"not":{}},{"type":"object","properties":{"refreshToken":{"type":"string"}},"additionalProperties":false}]}}}},"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/verify-email":{"post":{"summary":"Verify a signup email using the token from the confirmation link.","tags":["auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string","minLength":10}},"required":["token"],"additionalProperties":false}}}},"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/resend-verification":{"post":{"summary":"Re-send the email verification link.","tags":["auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string","format":"email"}},"required":["email"],"additionalProperties":false}}}},"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/forgot-password":{"post":{"summary":"Start a password-reset flow (emails a reset link).","tags":["auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string","format":"email"}},"required":["email"],"additionalProperties":false}}}},"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/reset-password":{"post":{"summary":"Complete a password reset using the token from the email.","tags":["auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string","minLength":10},"newPassword":{"type":"string","minLength":10}},"required":["token","newPassword"],"additionalProperties":false}}}},"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/logout":{"post":{"summary":"Log out the current session and clear cookies.","tags":["auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"anyOf":[{"not":{}},{"type":"object","properties":{"refreshToken":{"type":"string"}},"additionalProperties":false}]}}}},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/logout-all":{"post":{"summary":"Terminate every active session for the current user.","tags":["auth"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/sessions":{"get":{"summary":"List active refresh-token sessions for the current user.","tags":["auth"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}},"delete":{"summary":"Revoke every other session for the current user.","tags":["auth"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/sessions/{id}":{"delete":{"summary":"Revoke a single refresh-token session.","tags":["auth"],"parameters":[{"schema":{"type":"string","minLength":1},"in":"path","name":"id","required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/wallet/nonce":{"get":{"summary":"Issue a Thanos-compatible nonce for a wallet address.","tags":["auth"],"description":"Returns text/plain to match the Thanos SDK's `nonceEndpoint` contract.","parameters":[{"schema":{"type":"string","pattern":"^0x[a-fA-F0-9]{40}$"},"in":"query","name":"address","required":true}],"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/wallet/challenge":{"post":{"summary":"Legacy SIWE challenge builder (server-side message).","tags":["auth"],"description":"Kept for the existing api-client / mobile usage; new clients should use /v1/auth/wallet/typed-challenge.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"address":{"type":"string","pattern":"^0x[a-fA-F0-9]{40}$"}},"required":["address"],"additionalProperties":false}}}},"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/wallet/typed-challenge":{"post":{"summary":"Issue an EIP-712 typed-data challenge for wallet login.","tags":["auth"],"description":"Response body is passed straight to `eth_signTypedData_v4` on the client.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"address":{"type":"string","pattern":"^0x[a-fA-F0-9]{40}$"}},"required":["address"],"additionalProperties":false}}}},"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/wallet/typed-verify":{"post":{"summary":"Verify an EIP-712 wallet signature and issue a session.","tags":["auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"address":{"type":"string","pattern":"^0x[a-fA-F0-9]{40}$"},"signature":{"type":"string","pattern":"^0x[a-fA-F0-9]+$"}},"required":["address","signature"],"additionalProperties":false}}}},"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/wallet/verify":{"post":{"summary":"Verify a wallet signature and issue a session.","tags":["auth"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"address":{"type":"string","pattern":"^0x[a-fA-F0-9]{40}$"},"signature":{},"message":{"type":"string"}},"required":["address"],"additionalProperties":false}}}},"responses":{"200":{"description":"Default Response"}}}},"/v1/user/withdrawal-address":{"get":{"summary":"The verified wallet address withdrawals are paid to.","tags":["user"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}},"post":{"summary":"Bind a signature-verified wallet address as the withdrawal destination.","tags":["user"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"address":{"type":"string","pattern":"^0x[a-fA-F0-9]{40}$"},"signature":{"type":"string","pattern":"^0x[a-fA-F0-9]+$"}},"required":["address","signature"],"additionalProperties":false}}}},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/user/withdrawal-address/challenge":{"post":{"summary":"Issue an EIP-712 challenge to prove control of a withdrawal address.","tags":["user"],"description":"Pass the response straight to `eth_signTypedData_v4`, then POST the signature to /v1/user/withdrawal-address.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"address":{"type":"string","pattern":"^0x[a-fA-F0-9]{40}$"}},"required":["address"],"additionalProperties":false}}}},"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/totp/setup":{"post":{"summary":"Begin two-factor enrolment.","tags":["auth"],"description":"Returns the shared secret, an otpauth:// URL for QR rendering, and 10 single-use backup codes. Backup codes are shown ONCE and are bcrypt-hashed individually at rest. Two-factor is not active until /verify-setup succeeds. Re-running setup while already enabled is rejected, so a working secret cannot be silently discarded.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/totp/verify-setup":{"post":{"summary":"Confirm two-factor enrolment with a code.","tags":["auth"],"description":"On success the access cookie is reissued so the token's totpEnabled claim is not stale for the rest of its 15-minute life.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/totp/disable":{"post":{"summary":"Disable two-factor.","tags":["auth"],"description":"Requires proof of identity: accounts with a password must send `password`; wallet and OAuth accounts (which have none) must send a current `totpCode`. Clears the secret and all backup codes.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/auth/totp/challenge":{"post":{"summary":"Complete a login with a TOTP or backup code.","tags":["auth"],"description":"Exchanges the `mfaPendingToken` returned by login (5-minute lifetime) for a full session. Accepts either a 6-digit authenticator code or one of the account's backup codes; a backup code is CONSUMED on use. Sets session cookies on success. Rate limited to 10 per 5 minutes.","responses":{"200":{"description":"Default Response"}}}},"/v1/auth/google":{"get":{"summary":"Redirect to the Google consent screen.","tags":["auth"],"description":"Browser flow. ALWAYS redirects, never returns JSON — including on a configuration error, where it redirects to the login page with ?error=oauth_not_configured.","responses":{"200":{"description":"Default Response"}}}},"/v1/auth/google/callback":{"get":{"summary":"Google OAuth callback.","tags":["auth"],"description":"Browser flow. ALWAYS redirects, never returns JSON. On success it redirects to the web app's callback route carrying the tokens, which sets the cookies server-side. When the account has TOTP enabled it redirects with ?google_mfa=1&token=<mfaPendingToken>. On failure it redirects with ?error=google_denied or ?error=google_failed.","responses":{"200":{"description":"Default Response"}}}},"/v1/auth/google/token":{"post":{"summary":"Exchange a Google authorization code for a session (native / SPA).","tags":["auth"],"description":"`redirectUri` must exactly match the one used with Google and must appear in the server-side allowlist; an empty string is permitted for native serverAuthCode flows. PKCE is supported via `codeVerifier`. Returns a session, or { mfaRequired, mfaPendingToken } when the account has TOTP enabled. 503 when Google OAuth is not configured.","responses":{"200":{"description":"Default Response"}}}},"/v1/dashboard":{"get":{"summary":"Platform dashboard payload.","tags":["telemetry"],"description":"Proxies the decision engine's dashboard view, which is derived from ENGINE WORKFLOW RUNS, not from the Agent table. The ids it returns are `workflow-<n>` and cannot be passed to /v1/agents/{id}. 502 when the engine is unreachable — there is no fallback at this layer.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/telemetry":{"get":{"summary":"Recent platform activity events.","tags":["telemetry"],"description":"Newest first. `limit` defaults to 25, maximum 100.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/telemetry/stream":{"get":{"summary":"SSE stream of platform activity.","tags":["telemetry"],"description":"text/event-stream. Sends `event: snapshot` with the 10 most recent events on connect, then `event: telemetry` per event. UNFILTERED — this is the whole platform bus, not one agent's events; for a single agent use /v1/agents/{id}/decisions/stream. No heartbeat and no retry: directive are emitted on this stream. Live-only: no replay, no Last-Event-ID, no backfill.","security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response"}}}},"/v1/agents":{"get":{"summary":"List agents for the current user.","tags":["agents"],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Default Response","content":{"application/json":{"schema":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"userId":{"type":"string"},"name":{"type":"string"},"strategy":{"type":"string"},"strategyPrompt":{"type":"string","nullable":true},"chains":{"type":"array","items":{"type":"string"}},"tokens":{"type":"array","items":{"type":"string"}},"dexPreference":{"type":"string